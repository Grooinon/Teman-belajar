# ==========================================
# TEMANBELAJAR CONFIGURATION
# ==========================================

APP_NAME="TemanBelajar"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Jakarta"

# Database Configuration (Default: MySQL for XAMPP)
# For instant testing without running MySQL service, set DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temanbelajar_db
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback path (used when DB_CONNECTION=sqlite or MySQL not available)
DB_SQLITE_PATH="storage/database/temanbelajar.sqlite"

# Session & Security
SESSION_LIFETIME=7200
CSRF_TOKEN_LIFETIME=3600
